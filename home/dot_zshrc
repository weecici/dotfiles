### FUNCTIONS ###
#################

fi-re() {
  emulate -L zsh
  setopt pipefail

  local from="$1"
  local to="$2"
  local dir="${3:-.}"

  if [[ -z "$from" || -z "$to" ]]; then
    print -u2 "usage: fi-re <from> <to> [dir]"
    return 1
  fi

  rg -l0 --fixed-strings --hidden --glob '!.git' -- "$from" "$dir" |
    xargs -0 python3 -c '
import sys
from pathlib import Path

old = sys.argv[1]
new = sys.argv[2]

for p in sys.argv[3:]:
    path = Path(p)
    try:
        data = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        continue
    updated = data.replace(old, new)
    if updated != data:
        path.write_text(updated, encoding="utf-8")
        print(path)
' "$from" "$to"
}

postgresql() {
    sudo chown -R $(whoami) $PGROOT 
    sudo mkdir -p /run/postgresql
    sudo chown -R $(whoami) /run/postgresql 
    pg_ctl $1
}

